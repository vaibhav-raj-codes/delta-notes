<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create new posts</title>
    <link href="/style.css" rel="stylesheet" />
</head>
<body>
    <form method="post" action="/posts" class="post">
        <input type="text" placeholder="Enter Username" name="username"><br><br>    
        <textarea name="content" id="form-content" placeholder="What's on your mind?"></textarea><br>
        <button>Submit</button>
    </form>
</body>
</html>