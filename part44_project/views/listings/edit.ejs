<% layout('/layouts/boilerplate') -%>

<div class="row mt-3">
  <div class="col-8 offset-2">
    <h1>Edit your listing</h1>
    <form action="/listings/<%= item._id %>?_method=PUT" method="POST" novalidate class="needs-validation">
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input type="text" name="listing[title]" value="<%= item.title %>" class="form-control" required />
        <div class="invalid-feedback">
          Please choose a title.
        </div>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea type="text" name="listing[description]" class="form-control" required><%= item.description %></textarea>
        <div class="invalid-feedback">
          Please enter a description of the place.
        </div>
      </div>

      <div class="mb-3">
        <label for="image" class="form-label">Image</label>
        <input type="text" name="listing[image][url]" value="<%= item.image.url %>" class="form-control" required />
        <div class="invalid-feedback">
          Please enter a url of image.
        </div>
      </div>
      <div class="row">
        <div class="mb-3 col-md-4">
          <label for="price" class="form-label">Price</label>
          <input type="number" name="listing[price]" value="<%= item.price %>" class="form-control" required />
          <div class="invalid-feedback">
            Please enter the price/night.
          </div>
        </div>

        <div class="mb-3 col-md-8">
          <label for="country" class="form-label">Country</label>
          <input type="text" name="listing[country]" value="<%= item.country %>" class="form-control" required />
          <div class="invalid-feedback">
            Please choose a country.
          </div>
        </div>
      </div>


      <div class="mb-3">
        <label for="location" class="form-label">Location</label>
        <input type="text" name="listing[location]" value="<%= item.location %>" class="form-control" required/>
        <div class="invalid-feedback">
          Please enter location of the listing.
        </div>
      </div>

      <button class="btn btn-dark edit-btn mb-5 mt-3">Edit</button>
    </form>
  </div>
</div>