<% layout('/layouts/boilerplate') -%>
<div class="row mt-3 mb-3">
  <div class="col-8 offset-3">
    <h3><b><%= item.title %></b></h3>
  </div>

  <div class="card col-6 offset-3 listing-card">
    <img src="<%= item.image.url %>" class="card-img-top show-img" alt="Listing image">
    <div class="card-body">
      <p class="card-text">
        <%= item.description %><br>
        &#8377; <%= item.price.toLocaleString("en-IN") %><br>
        <%= item.location %><br>
        <%= item.country %><br>
      </p>
    </div>
  </div>

  <div class="row">
    <div class="col-6 offset-3">
      <hr>
      <div class="d-flex mt-3 gap-2">
        <a href="/listings" class="btn btn-dark flex-fill show-btn">back</a>
        <a href="/listings/<%= item._id %>/edit" class="btn btn-dark flex-fill show-btn">Edit this info</a>
        <form action="/listings/<%= item._id %>?_method=DELETE" method="post" class="flex-fill d-flex">
          <button class="btn btn-dark w-100 show-btn">delete this</button>
        </form>
      </div>
      <hr>
    </div>
  </div>

  <div class="card col-8 offset-3 mt-3">
    <h4>Leave us a Review</h4>
    <form action="/listings/<%= item._id %>/reviews" method="POST" novalidate class="needs-validation">
      <div class="mb-3 mt-3 col-3">
        <label for="rating" class="form-label">rating</label>
        <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
      </div>
      <div class="mb-3 mt-3">
        <label for="comment" class="form-label">Comments</label>
        <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
        <div class="invalid-feedback">
          Please provide a valid review.
        </div>
      </div>
      <button class="btn btn-dark d-block px-4 review-btn">submit</button>
    </form>

    <hr>

    <h4>All Reviews:</h4>
    <div class="row">
      <% for(review of item.reviews) { %>
      <div class="card col-5 mb-3 ms-3 p-2">
        <div class="card-body">
          <h5 class="card-title">User</h5>
          <p class="card-text"><%= review.comment %></p>
          <p class="card-text"><%= review.rating %> stars</p>
        </div>
        <form class="mb-2" method="POST" action="/listings/<%= item._id %>/reviews/<%= review._id %>?_method=DELETE">
          <button class="btn btn-sm delete-btn btn-dark">delete</button>
        </form>
      </div>
      <% } %>
    </div>

  </div>
</div>