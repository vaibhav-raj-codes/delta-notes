<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Random-number-generator</title>
</head>
<body>
    <h1>Your dice rolled to <%= data %> </h1>
    <% let i = 1; %>
    <% while(i <= data) { %>
        <p><%= i %></p>
    <% i++; } %>
</body>
</html>